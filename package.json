{
  "name": "linkedin-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "auth:hash": "tsx src/auth/hash-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "tsx src/cli.ts",
    "db:init": "npm run cli -- db init",
    "lead:add": "npm run cli -- lead add",
    "lead:list": "npm run cli -- lead list",
    "lead:status": "npm run cli -- lead status",
    "outreach:mock": "BROWSER_WORKER=mock npm run cli -- outreach run",
    "monitor:mock": "BROWSER_WORKER=mock npm run cli -- monitor run",
    "outreach:run": "npm run cli -- outreach run",
    "monitor:run": "npm run cli -- monitor run",
    "telegram:id": "tsx src/telegram/discover-id.ts",
    "telegram:webhook": "tsx src/telegram/webhook-cli.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
