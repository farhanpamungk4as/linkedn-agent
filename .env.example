DATABASE_PATH=./data/leads.db
APP_PORT=3000
APP_HOST=127.0.0.1
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
BROWSER_WORKER=mock
BROWSER_CDP_URL=
# Existing private Docker network shared with ai-chrome; used by docker-compose.prod.yml.
EXTERNAL_DOCKER_NETWORK=
OUTREACH_MODE=manual
OUTREACH_DAILY_LIMIT=20
# Empty defaults to true in mock mode and false in Playwright mode.
AUTOMATION_ENABLED=

# Required when exposed outside localhost or in Docker production.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Empty defaults to true in production and false on local HTTP.
COOKIE_SECURE=

# Leave token empty for console notifications and no Telegram controller.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID allowed to control the bot. Also notification target by default.
TELEGRAM_ALLOWED_USER_ID=
# Optional separate notification target.
TELEGRAM_CHAT_ID=
# Local: polling. VPS with public HTTPS: webhook.
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
# Random 32+ characters, A-Z a-z 0-9 _ - (for example: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
TELEGRAM_WEBHOOK_SECRET=
# URL dashboard yang dapat dibuka dari Telegram, misalnya http://127.0.0.1:3000 saat lokal.
APP_PUBLIC_URL=http://127.0.0.1:3000

# Intervals in seconds.
OUTREACH_INTERVAL=300
REPLY_MONITOR_INTERVAL=120
OUTREACH_ENABLED=true
MONITOR_ENABLED=true

# Optional future orchestrator. Core runs when disabled or unavailable.
HERMES_ENABLED=false
HERMES_BASE_URL=
HERMES_API_KEY=
